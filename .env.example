# Fictional local values only. Prefer npm run db:setup to generate .env.local.
# Never copy production credentials here. PostgreSQL belongs exclusively to TRAMA.
TRAMA_DB_PORT=55432
TRAMA_DB_PASSWORD=replace-with-a-local-only-password
DATABASE_URL=postgresql://trama_local:replace-with-a-local-only-password@127.0.0.1:55432/trama_local

# Fictional placeholders. Run npm run auth:setup for a local random secret.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-local-secret-at-least-32-characters
TRAMA_ADMIN_EMAIL=admin@example.test
GOOGLE_CLIENT_ID=replace-with-local-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-local-google-client-secret
