# Fictional local values only. Prefer npm run db:setup to generate .env.local.
# Never copy production credentials here. PostgreSQL belongs exclusively to TRAMA.
TRAMA_DB_PORT=55432
TRAMA_DB_PASSWORD=replace-with-a-local-only-password
DATABASE_URL=postgresql://trama_local:replace-with-a-local-only-password@127.0.0.1:55432/trama_local
